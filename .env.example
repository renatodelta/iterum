# ==============================================================================
# EXEMPLO de variáveis de ambiente. NUNCA coloque valores reais neste arquivo!
# Copie para ".env" (que é ignorado pelo Git) e preencha lá. Na Vercel, use
# Project Settings > Environment Variables.
# ==============================================================================

# BANCO DE DADOS (PostgreSQL)
STORAGE_DATABASE_URL="postgresql://usuario:senha@localhost:5432/clinidesk?schema=public"

# PROVEDOR DE INTELIGÊNCIA ARTIFICIAL (Configure pelo menos um)
OPENAI_API_KEY="sk-proj-sua-chave-openai-aqui"
GEMINI_API_KEY="AIzaSy-sua-chave-gemini-aqui"

# INTEGRAÇÃO WHATSAPP - META CLOUD API OFICIAL (tem prioridade se preenchida)
META_ACCESS_TOKEN="seu-token-de-acesso-da-meta-aqui"
META_PHONE_NUMBER_ID="seu-phone-number-id-aqui"
META_GRAPH_VERSION="v21.0"
# Token que VOCÊ inventa (aleatório e longo) e informa também no painel da Meta ao configurar o webhook
VERIFY_TOKEN="gere-um-valor-aleatorio-longo-aqui"
# "Chave secreta do aplicativo" (App Secret) da Meta: usada para validar a assinatura dos webhooks
META_APP_ID="seu-app-id-da-meta-aqui"
META_APP_SECRET="seu-app-secret-da-meta-aqui"

# INTEGRAÇÃO WHATSAPP (Evolution API / Z-API) - opcional
WHATSAPP_API_URL="https://sua-api-whatsapp.exemplo.com"
WHATSAPP_API_KEY="seu-token-aqui"
EVOLUTION_INSTANCE_NAME="nome-da-sua-instancia"
# Segredo que o provedor alternativo deve enviar no header "x-webhook-secret" (mín. 16 caracteres).
# Sem este valor, webhooks que não sejam da Meta são recusados.
WEBHOOK_SECRET="gere-um-valor-aleatorio-longo-aqui"

# LOGIN DO SISTEMA
# Segredo que assina o cookie de login (mín. 32 caracteres, aleatório). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="gere-um-valor-aleatorio-com-pelo-menos-32-caracteres"
# Administrador inicial. Gere o hash da senha com:  node scripts/hash-password.js "SuaSenhaForte123"
ADMIN_LOGIN="admin"
ADMIN_PASSWORD_HASH="cole-aqui-o-hash-gerado-pelo-script"

# SEGURANÇA & CRON
# Token dos agendadores (cron) e da fila interna (mín. 16 caracteres, aleatório). Sem este valor o cron e a fila ficam desligados.
CRON_SECRET="gere-um-valor-aleatorio-longo-aqui"
# URL pública do sistema (usada pela fila interna para chamar o worker)
APP_URL="https://seu-dominio.exemplo.com"
